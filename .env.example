# Angle brackets are deliberate — a literal user:password@host placeholder here
# trips the gitleaks postgres-url-with-credentials rule and blocks the commit.
DATABASE_URL=postgres://<user>:<password>@<host>/<dbname>?sslmode=require
ANTHROPIC_API_KEY=sk-ant-...
CRON_SECRET=long-random-string
SITE_URL=https://pitchroots.ca
