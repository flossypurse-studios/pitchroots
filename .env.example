# Angle brackets are deliberate — a literal user:password@host placeholder here
# trips the gitleaks postgres-url-with-credentials rule and blocks the commit.
DATABASE_URL=postgres://<user>:<password>@<host>/<dbname>?sslmode=require
ANTHROPIC_API_KEY=sk-ant-...
CRON_SECRET=long-random-string
SITE_URL=https://pitchroots.ca

# GA4 measurement ID for pitchroots.ca (property 549942979).
#
# ⚠ BUILD-TIME, NOT RUNTIME. Next.js inlines NEXT_PUBLIC_* into the client
# bundle when `next build` runs. A runtime secret cannot supply this, and
# setting it in Vercel *after* a deploy does not reach that deploy's bundle —
# you must redeploy. If it is missing at build, the analytics code compiles to
# nothing, the build still succeeds, and the site ships untracked with no error.
# next.config.ts fails the production build to stop exactly that; override with
# ALLOW_MISSING_GA=true for a deliberately untracked build.
#
# Set in Vercel: Project Settings → Environment Variables (Production + Preview).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XKX0MV60DB
