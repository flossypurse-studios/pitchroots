# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Opting in: .env.example holds no secrets, and it is where the build-time-only
# nature of NEXT_PUBLIC_GA_MEASUREMENT_ID is written down. Ignored, that warning
# reaches nobody but the machine that wrote it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# mycadre worktree tracking (machine-local absolute paths)
.mycadre-state.json
